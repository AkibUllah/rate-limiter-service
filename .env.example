# Application
APP_NAME=rate-limiter-service
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend: leave REDIS_URL unset for the in-process backend (single instance),
# set it to share limits across instances.
# REDIS_URL=redis://redis:6379/0
KEY_PREFIX=rl:

# Optional shared secret for /v1/*; when set, clients must send X-API-Key.
# API_KEY=replace-with-a-long-random-string

# Default policy used when /v1/check receives a policy name that does not exist
# and the inline policy is omitted. Format: <limit>/<second|minute|hour|day>[;algorithm=<name>][;burst=<n>]
DEFAULT_POLICY=60/minute;algorithm=sliding_counter

# Protects the service's own endpoints (per client IP)
SERVICE_POLICY=1000/minute;algorithm=token_bucket
